# Copy to .env (which is gitignored) and set a password. Used by compose.yaml.
POSTGRES_DB=saharvest
POSTGRES_USER=saharvest
POSTGRES_PASSWORD=

# JWT signing key: a SECRET. Generate your own (e.g. `openssl rand -base64 48`); never commit a real one.
JWT_SIGNING_KEY=
JWT_EXPIRY_MINUTES=60

# Foodspace API key: a SECRET, sent as the X-Api-Key header. Leave empty while the simulator stands in for Foodspace.
FOODSPACE_API_KEY=

# DEV/TEST ONLY: shared password for the seeded test users (cbo_test_user, vetting_test_user, admin_test_user).
SEED_TEST_PASSWORD=Dev-UZVt4S4SYzfclL
