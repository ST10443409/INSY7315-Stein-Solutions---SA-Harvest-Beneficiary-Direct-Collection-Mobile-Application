{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SAHarvest.Api",
    "Audience": "SAHarvest.Mobile",
    "ExpiryMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Foodspace": {
    "ForwardingEnabled": true,
    "PollIntervalSeconds": 15,
    "MaxAttempts": 8,
    "BaseDelaySeconds": 30
  },
  "ExternalApi": {
    "BaseUrl": "http://localhost:5284"
  }
}
