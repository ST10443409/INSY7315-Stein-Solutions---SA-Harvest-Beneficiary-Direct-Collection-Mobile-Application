<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Nothing is backed up to the cloud or copied to a new phone (#54): the database and attachments hold
     beneficiary and donor details, signatures and photos, and the auth token is bound to a device Keystore key.
     Unsynced records therefore do not move to a new phone: sync before changing phones. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
