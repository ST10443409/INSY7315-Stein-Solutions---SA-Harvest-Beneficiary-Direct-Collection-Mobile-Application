<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds (#54): HTTPS only, trusting only the system's certificate authorities, never one a user (or anyone
     with the phone in hand) installed, which is the usual way to read an app's traffic. Debug builds use
     src/debug/res/xml/network_security_config.xml instead, which also allows plain HTTP to the local backend. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
