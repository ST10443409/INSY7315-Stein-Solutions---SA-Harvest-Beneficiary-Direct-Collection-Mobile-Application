# Copy to keystore.properties (gitignored) to build a SIGNED release APK on your own machine. In CI the same four values come
# from environment variables instead (ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD).
# The release keystore is created once, by the person who owns releases, and kept backed up outside the repository; see
# docs/android-release.md. Never put real values in this example file.
storeFile=C:/path/outside/the/repo/sah-release.jks
storePassword=
keyAlias=sah-release
keyPassword=
